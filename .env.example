# Copy to .env.local. Every value below has a working default —
# the app boots and the UI renders with this file entirely unset.

# ── TrueForge harness ─────────────────────────────────────────────
# The agent runtime. Start it with `npx @truefoundry/trueforge`,
# which serves the console and API on :8790.
TRUEFORGE_BASE_URL=http://localhost:8790

# Only needed if you deploy the harness behind auth. Local runs need nothing.
TRUEFORGE_API_KEY=

# ── Not here on purpose ───────────────────────────────────────────
# Bright Data, Daytona and the OpenAI-compatible model provider are
# configured *inside* TrueForge, not in this app. The app never holds
# those credentials — it asks the harness, and the harness makes the call.
# Configure them in the TrueForge console at $TRUEFORGE_BASE_URL.
